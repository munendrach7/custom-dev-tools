# --- SQL database (Microsoft SQL Server) ---
# Must meet SQL Server complexity rules (>=8 chars, mixed case + digits).
MSSQL_SA_PASSWORD=DevToolsStrong123
MSSQL_DB=devtools

# Secret used to sign API Client JWTs — change this in production.
SECRET_KEY=change-me-in-production
# JWT lifetime in minutes (default 7 days).
TOKEN_EXPIRE_MINUTES=10080

# Only needed if your network requires an egress proxy for outbound API calls.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=

# Optional corporate pip mirror used at image build time.
# PIP_INDEX_URL=

# Local (non-Docker) dev uses SQLite by default. To point the FastAPI backend at
# SQL Server locally instead, set:
# DATABASE_URL=mssql+pymssql://sa:DevToolsStrong123@localhost:1433/devtools
